# TypeSafe の API キー（推奨）
# https://console.typesafe.ai/settings/keys
#
# GitHub に登録する場合:
# Settings → Secrets and variables → Actions → New repository secret
# Name: TYPESAFE_API_KEY
#
# GitHub Pages は静的サイトなので、このキーを Pages 上で隠したまま使えません。
# Jev 対局の公開には Vercel など Node サーバーに同じキーを入れてください。
TYPESAFE_API_KEY=

# TypeSafe キーがない場合の代替。OpenRouter 経由で Jev を呼びます
# OPENROUTER_API_KEY=

# GitHub Pages のフロントから Vercel 上の API を叩くとき
# NEXT_PUBLIC_API_BASE=https://your-app.vercel.app
